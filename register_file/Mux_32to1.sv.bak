module mux_32to1 (
    input  wire [31:0] data_in [0:31],
    input  wire [4:0]  sel,
    output wire [31:0] data_out
);

    //==================================================
    // 1. DAO 5 BIT SELECT
    //==================================================
    wire s4_n, s3_n, s2_n, s1_n, s0_n;

    not U_NOT4 (s4_n, sel[4]);
    not U_NOT3 (s3_n, sel[3]);
    not U_NOT2 (s2_n, sel[2]);
    not U_NOT1 (s1_n, sel[1]);
    not U_NOT0 (s0_n, sel[0]);


    //==================================================
    // 2. TAO 32 MINTERM
    // m[i] = 1 khi sel = i
    //==================================================
    wire [31:0] m;

    and U_M0  (m[0],  s4_n, s3_n, s2_n, s1_n, s0_n);
    and U_M1  (m[1],  s4_n, s3_n, s2_n, s1_n, sel[0]);
    and U_M2  (m[2],  s4_n, s3_n, s2_n, sel[1], s0_n);
    and U_M3  (m[3],  s4_n, s3_n, s2_n, sel[1], sel[0]);

    and U_M4  (m[4],  s4_n, s3_n, sel[2], s1_n, s0_n);
    and U_M5  (m[5],  s4_n, s3_n, sel[2], s1_n, sel[0]);
    and U_M6  (m[6],  s4_n, s3_n, sel[2], sel[1], s0_n);
    and U_M7  (m[7],  s4_n, s3_n, sel[2], sel[1], sel[0]);

    and U_M8  (m[8],  s4_n, sel[3], s2_n, s1_n, s0_n);
    and U_M9  (m[9],  s4_n, sel[3], s2_n, s1_n, sel[0]);
    and U_M10 (m[10], s4_n, sel[3], s2_n, sel[1], s0_n);
    and U_M11 (m[11], s4_n, sel[3], s2_n, sel[1], sel[0]);

    and U_M12 (m[12], s4_n, sel[3], sel[2], s1_n, s0_n);
    and U_M13 (m[13], s4_n, sel[3], sel[2], s1_n, sel[0]);
    and U_M14 (m[14], s4_n, sel[3], sel[2], sel[1], s0_n);
    and U_M15 (m[15], s4_n, sel[3], sel[2], sel[1], sel[0]);

    and U_M16 (m[16], sel[4], s3_n, s2_n, s1_n, s0_n);
    and U_M17 (m[17], sel[4], s3_n, s2_n, s1_n, sel[0]);
    and U_M18 (m[18], sel[4], s3_n, s2_n, sel[1], s0_n);
    and U_M19 (m[19], sel[4], s3_n, s2_n, sel[1], sel[0]);

    and U_M20 (m[20], sel[4], s3_n, sel[2], s1_n, s0_n);
    and U_M21 (m[21], sel[4], s3_n, sel[2], s1_n, sel[0]);
    and U_M22 (m[22], sel[4], s3_n, sel[2], sel[1], s0_n);
    and U_M23 (m[23], sel[4], s3_n, sel[2], sel[1], sel[0]);

    and U_M24 (m[24], sel[4], sel[3], s2_n, s1_n, s0_n);
    and U_M25 (m[25], sel[4], sel[3], s2_n, s1_n, sel[0]);
    and U_M26 (m[26], sel[4], sel[3], s2_n, sel[1], s0_n);
    and U_M27 (m[27], sel[4], sel[3], s2_n, sel[1], sel[0]);

    and U_M28 (m[28], sel[4], sel[3], sel[2], s1_n, s0_n);
    and U_M29 (m[29], sel[4], sel[3], sel[2], s1_n, sel[0]);
    and U_M30 (m[30], sel[4], sel[3], sel[2], sel[1], s0_n);
    and U_M31 (m[31], sel[4], sel[3], sel[2], sel[1], sel[0]);


    //==================================================
    // 3. AND TUNG MINTERM VOI DU LIEU
    // term[i] = data_in[i] AND m[i]
    // Moi thanh ghi co 32 bit => 1024 cong AND
    //==================================================
    wire [31:0] term [0:31];

    genvar i, b;

    generate
        for (i = 0; i < 32; i = i + 1) begin : GEN_MASK
            for (b = 0; b < 32; b = b + 1) begin : GEN_BIT
                and U_AND_DATA (
                    term[i][b],
                    data_in[i][b],
                    m[i]
                );
            end
        end
    endgenerate


    //==================================================
    // 4. CAY CONG OR: 32 NGO VAO -> 1 NGO RA
    //==================================================

    // Tang 1: 32 -> 16
    wire [31:0] or_l1 [0:15];

    generate
        for (i = 0; i < 16; i = i + 1) begin : GEN_OR1
            for (b = 0; b < 32; b = b + 1) begin : GEN_BIT
                or U_OR (
                    or_l1[i][b],
                    term[2*i][b],
                    term[2*i+1][b]
                );
            end
        end
    endgenerate

    // Tang 2: 16 -> 8
    wire [31:0] or_l2 [0:7];

    generate
        for (i = 0; i < 8; i = i + 1) begin : GEN_OR2
            for (b = 0; b < 32; b = b + 1) begin : GEN_BIT
                or U_OR (
                    or_l2[i][b],
                    or_l1[2*i][b],
                    or_l1[2*i+1][b]
                );
            end
        end
    endgenerate

    // Tang 3: 8 -> 4
    wire [31:0] or_l3 [0:3];

    generate
        for (i = 0; i < 4; i = i + 1) begin : GEN_OR3
            for (b = 0; b < 32; b = b + 1) begin : GEN_BIT
                or U_OR (
                    or_l3[i][b],
                    or_l2[2*i][b],
                    or_l2[2*i+1][b]
                );
            end
        end
    endgenerate

    // Tang 4: 4 -> 2
    wire [31:0] or_l4 [0:1];

    generate
        for (i = 0; i < 2; i = i + 1) begin : GEN_OR4
            for (b = 0; b < 32; b = b + 1) begin : GEN_BIT
                or U_OR (
                    or_l4[i][b],
                    or_l3[2*i][b],
                    or_l3[2*i+1][b]
                );
            end
        end
    endgenerate

    // Tang 5: 2 -> 1
    wire [31:0] or_l5;

    generate
        for (b = 0; b < 32; b = b + 1) begin : GEN_OR5
            or U_OR (
                or_l5[b],
                or_l4[0][b],
                or_l4[1][b]
            );
        end
    endgenerate

    // Dau ra cuoi cung
    assign data_out = or_l5;

endmodule