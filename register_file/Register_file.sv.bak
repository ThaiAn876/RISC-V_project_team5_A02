module register_file (
  input  logic        i_clk,
  input  logic        i_rstn,
  input  logic [4:0]  i_rs1_addr,
  input  logic [4:0]  i_rs2_addr,
  input  logic [4:0]  i_rd_addr,
  input  logic [31:0] i_rd_data,
  input  logic        i_rd_wren,
  output logic [31:0] o_rs1_data,
  output logic [31:0] o_rs2_data
);

  logic [31:0] registers[1:31];
  integer i;

  // Asynchronous active-low reset; x0 is implicit and always zero.
  always_ff @(posedge i_clk or negedge i_rstn) begin
    if (!i_rstn) begin
      for (i = 1; i < 32; i = i + 1) begin
        registers[i] <= 32'b0;
      end
    end else if (i_rd_wren && (i_rd_addr != 5'd0)) begin
      registers[i_rd_addr] <= i_rd_data;
    end
  end

  // Combinational read ports.
  always_comb begin
    o_rs1_data = (i_rs1_addr == 5'd0) ? 32'b0 : registers[i_rs1_addr];
    o_rs2_data = (i_rs2_addr == 5'd0) ? 32'b0 : registers[i_rs2_addr];
  end

endmodule